{
  "manifest_version": 2,
  "browser_specific_settings": {
    "gecko": {
      "id": "shields@aion.nath.com"
    }
  },
  "name": "Aion pop-up blocker",
  "version": "1.0",
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "shields.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "permissions": [
    "<all_urls>"
  ]
}